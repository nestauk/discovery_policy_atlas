# OpenAlex asks for email for polite use (optional but recommended)
OPENALEX_EMAIL=
OPENALEX_API_KEY=

# Overton API key
OVERTON_API_KEY=

# LLM configuration
LLM_SERVICE=OpenAI
OPENAI_API_KEY=

# Clerk auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
# Organisation whose projects are visible to all
DEMO_ORG_ID=

# Database
SUPABASE_URL=
SUPABASE_KEY=

# Allowed incoming sources to backend API calls
BACKEND_CORS_ORIGINS = your-app.url,http://localhost:3000

# Development/testing
MOCK_OPENAI=false

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=

# Google Sheet IDs for Agency & Resilience exports (scripts/exports/export_agency_resilience.py)
AR_BOTTOM_UP_SHEET_ID=
AR_TOP_DOWN_SHEET_ID=
AR_WILDCARD_SHEET_ID=
